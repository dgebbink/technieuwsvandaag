[Unit]
Description=TechNieuwsVandaag Telegram Bot
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=dgebbink
WorkingDirectory=/home/dgebbink/projects/technieuwsvandaag
ExecStart=/home/dgebbink/.pyenv/shims/python3 /home/dgebbink/projects/technieuwsvandaag/telegram_bot.py
Restart=always
RestartSec=30
StandardOutput=append:/home/dgebbink/projects/technieuwsvandaag/logs/telegram_bot.log
StandardError=append:/home/dgebbink/projects/technieuwsvandaag/logs/telegram_bot.log
EnvironmentFile=/home/dgebbink/projects/technieuwsvandaag/.env

[Install]
WantedBy=multi-user.target
